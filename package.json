{
  "name": "prompt-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:run-state": "node scripts/test-run-state.mjs",
    "test:viewer": "node scripts/test-markdown-viewer.mjs",
    "test:ai-safe-json": "node --experimental-strip-types scripts/test-ai-safe-json.mjs",
    "test:ai-search-index": "node --experimental-strip-types scripts/test-ai-search-index.mjs",
    "test:cloudflare-ai-search": "node --experimental-strip-types scripts/test-cloudflare-ai-search.mjs",
    "test:content-sync": "node scripts/test-content-sync-planning.mjs",
    "test": "npm run test:run-state && npm run test:viewer && npm run test:ai-safe-json && npm run test:ai-search-index && npm run test:cloudflare-ai-search && npm run test:content-sync",
    "content:validate": "python -m scripts.cli validate",
    "content:build": "python -m scripts.cli build",
    "content:test": "python -m unittest discover -s scripts/tests -p \"test_*.py\"",
    "content:plan": "python -m scripts.cli plan",
    "content:sync": "python -m scripts.cli sync",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "project:ci": "npm run typecheck && npm run db:migrate:local && npm run content:validate && npm run content:build && npm run content:test && npm test && npm run worker:dry-run",
    "ci": "node scripts/run-ci-with-log.mjs",
    "run:latest": "node scripts/get-latest-run.mjs",
    "log:latest": "node scripts/get-latest-run.mjs --logs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "kv:seed": "wrangler kv bulk put seed/kv-prompts.json --binding PROMPT_KV"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.17.4",
    "hono": "4.12.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "typescript": "5.9.3",
    "wrangler": "4.109.0"
  }
}
