# Optional. When set, callers that send this Bearer token can also query
# private prompt files. Anonymous callers only see public files.
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Required only for local testing of the protected content synchronization API.
# Production deployments rotate this secret automatically in GitHub Actions.
CONTENT_SYNC_TOKEN=replace-with-a-separate-long-random-token
